# ==============================================================================
# xhs-ai-ops 环境配置模板（Docker 隔离版）
# 复制为 config/.env 后按需填写；若系统环境变量已存在对应键，则自动继承。
# ==============================================================================

# 1. Google Gemini 图像生成配置（模块 0C：baoyu-image-gen）
# 若系统环境变量已导出 GOOGLE_API_KEY，此处可留空
GOOGLE_API_KEY=
# 可选：自定义 Gemini 生图模型（默认 gemini-3-pro-image，也可选 gemini-3.1-flash-image）
GOOGLE_IMAGE_MODEL=gemini-3-pro-image
# 可选：自定义 Google API 网关地址（不填走官方 generativelanguage.googleapis.com）
# GOOGLE_BASE_URL=

# 2. 小红书 MCP 容器配置（模块 0B：xiaohongshu-mcp Docker 隔离模式）
# 默认仅监听本机回环地址，防止局域网/公网访问
XHS_MCP_ADDR=127.0.0.1:18060
# 默认镜像名（由 python infra/ops.py build-image 按宿主机架构自动构建，使用 Debian 官方开源 Chromium）
# XHS_MCP_IMAGE=xhs-ai-ops-mcp:amd64
# 可选：自定义 Docker 基础镜像（默认自动探测本地 python:3.12-slim-bookworm 或 debian:bookworm-slim）
# XHS_BASE_IMAGE=debian:bookworm-slim
# 可选：容器内浏览器代理（国内访问小红书通常建议留空直连）
# XHS_PROXY=
# 可选：远程部署鉴权 Token（仅本机 127.0.0.1 配合 AI 客户端使用时建议留空）
# AUTH_TOKEN=
