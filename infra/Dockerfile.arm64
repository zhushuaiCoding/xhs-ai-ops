# 原生 linux/arm64 安全沙箱镜像（基于本地已有 Debian Bookworm arm64 镜像 + 官方源开源 Chromium，零 QEMU、零第三方 CDN 浏览器）
FROM python:3.12-slim-bookworm

ENV TZ=Asia/Shanghai
ENV DEBIAN_FRONTEND=noninteractive

# 使用阿里云 Debian 镜像源安装官方维护的开源 Chromium 与中文字体
RUN sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources && \
    apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates \
      chromium \
      curl \
      fonts-liberation \
      fonts-noto-color-emoji \
      fonts-wqy-zenhei \
      tini \
      tzdata \
    && ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
RUN mkdir -p /app/data/home /app/data/config /app/images && chmod -R 777 /app/data /app/images

COPY app /app/app
RUN chmod +x /app/app

ENV HOME=/app/data/home
ENV XDG_CONFIG_HOME=/app/data/config
ENV XHS_BROWSER_BIN=/usr/bin/chromium

EXPOSE 18060
ENTRYPOINT ["/usr/bin/tini", "-s", "--"]
CMD ["./app"]
